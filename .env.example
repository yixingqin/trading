# Copy to .env and fill in your values

# Robinhood MCP endpoint
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# OAuth access token from the Robinhood MCP connector in claude.ai
# Settings → Connectors → Robinhood → copy the Bearer token shown there
ROBINHOOD_API_TOKEN=

# Agentic cash account number (agentic_allowed=true) — full number, not masked
# Run: python cli.py account   to confirm after setting token
TRADING_ACCOUNT_ID=692348949

# Risk parameters
POSITION_SIZE_PCT=0.05
ACCOUNT_SIZE=5000
